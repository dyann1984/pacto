NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Nunca colocar service_role en NEXT_PUBLIC_*. Foundation no necesita esa clave.

# Fase 2 (opcional en local; nunca con prefijo NEXT_PUBLIC_):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Solo para pruebas E2E con usuarios DEMO (nombres; los valores van en .env.local):
PACTO_DEMO_A_EMAIL=
PACTO_DEMO_A_PASSWORD=
PACTO_DEMO_B_EMAIL=
PACTO_DEMO_B_PASSWORD=
PACTO_DEMO_B_ID=
PACTO_E2E_AI=not-configured

# Fase 3 (solo local, solo para scripts/provision-demo-admin.mjs; NUNCA en
# src/, nunca en Vercel, nunca commiteada): clave service_role del proyecto
# Supabase, en Project Settings → API. Permite crear cuentas DEMO
# preconfirmadas sin depender del envío de correo.
SUPABASE_SERVICE_ROLE_KEY=

# ID del Pacto público marcado is_demo_example=true (ver scripts/seed-demo-example.mjs).
# No es sensible: solo identifica el registro de ejemplo.
PACTO_DEMO_EXAMPLE_ID=
