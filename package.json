{
    "name":  "pacto",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev --webpack --hostname 127.0.0.1",
                    "build":  "next build --webpack",
                    "start":  "next start --hostname 127.0.0.1",
                    "lint":  "eslint .",
                    "typecheck":  "next typegen && tsc --noEmit",
                    "test":  "vitest run",
                    "test:authorization":  "vitest run tests/authorization.test.ts",
                    "test:rls":  "vitest run tests/rls.test.ts",
                    "test:e2e":  "playwright test",
                    "check:demo-users":  "node --env-file=.env.local scripts/check-demo-users.mjs",
                    "check:secrets":  "node scripts/check-public-exposure.mjs"
                },
    "dependencies":  {
                         "@supabase/ssr":  "^0.7.0",
                         "@supabase/supabase-js":  "^2.0.0",
                         "next":  "^16.0.0",
                         "react":  "^19.0.0",
                         "react-dom":  "^19.0.0",
                         "server-only":  "^0.0.1",
                         "zod":  "^4.0.0"
                     },
    "devDependencies":  {
                            "@electric-sql/pglite":  "^0.3.0",
                            "@playwright/test":  "^1.0.0",
                            "@types/node":  "^22.0.0",
                            "@types/react":  "^19.0.0",
                            "@types/react-dom":  "^19.0.0",
                            "agent-browser":  "^0.38.2",
                            "eslint":  "^9.0.0",
                            "eslint-config-next":  "^16.0.0",
                            "prettier":  "^3.9.9",
                            "typescript":  "^5.0.0",
                            "vitest":  "^3.0.0"
                        },
    "packageManager":  "pnpm@11.28.5"
}
